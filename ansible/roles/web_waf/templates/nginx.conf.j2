# Managed by Ansible. This complete template intentionally does not include conf.d.
# Only this static server is enabled; generated proxy/TLS/metrics servers are unused.
load_module modules/ngx_http_modsecurity_module.so;
user nginx;
worker_processes 1;
pid /tmp/nginx.pid;
error_log {{ lab_web_log_dir }}/error.log warn;

events { worker_connections 512; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    keepalive_timeout 15s;
    client_body_timeout 10s;
    client_header_timeout 10s;
    client_max_body_size 1m;

    # The socket peer is authoritative. No real_ip_header/set_real_ip_from/XFF trust.
    log_format lab_json escape=json
        '{"time":"$time_iso8601","client_ip":"$remote_addr",'
        '"method":"$request_method","uri":"$uri","status":$status,'
        '"bytes":$body_bytes_sent,"request_time":$request_time,'
        '"request_id":"$request_id","correlation_id":"$http_x_lab_correlation_id"}';
    access_log {{ lab_web_log_dir }}/access.jsonl lab_json;

    modsecurity on;
    modsecurity_rules_file /etc/modsecurity.d/setup.conf;
    modsecurity_transaction_id "$request_id";

    server {
        listen {{ lab_web_bind_address }}:{{ lab_web_http_port }} default_server;
        server_name _;
        root /srv/ozzylogik/site;
        index index.html;
        add_header X-Lab-Request-ID $request_id always;
        add_header X-Content-Type-Options nosniff always;
        location / {
            try_files $uri $uri/ =404;
        }
    }
}
