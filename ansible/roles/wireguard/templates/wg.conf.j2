# Managed from externally supplied secrets. Never enable SaveConfig.
# LocalPublicKey = {{ lab_wg_hub_public_key if inventory_hostname in groups.get('monitoring', []) else lab_wg_web_public_key }}
[Interface]
Address = {{ lab_hub_wg_ip if inventory_hostname in groups.get('monitoring', []) else lab_web_wg_ip }}/{{ lab_vpn_prefixlen }}
ListenPort = {{ lab_wireguard_port }}
PrivateKey = {{ lab_wg_hub_private_key if inventory_hostname in groups.get('monitoring', []) else lab_wg_web_private_key }}
MTU = {{ lab_wireguard_mtu }}

{% if inventory_hostname in groups.get('monitoring', []) %}
[Peer]
PublicKey = {{ lab_wg_web_public_key }}
AllowedIPs = {{ lab_web_wg_ip }}/32

[Peer]
PublicKey = {{ lab_wg_admin_public_key }}
AllowedIPs = {{ lab_admin_wg_ip }}/32

{% if lab_reviewer_enabled | bool %}
[Peer]
PublicKey = {{ lab_wg_reviewer_public_key }}
AllowedIPs = {{ lab_reviewer_wg_ip }}/32
{% endif %}
{% else %}
[Peer]
PublicKey = {{ lab_wg_hub_public_key }}
AllowedIPs = {{ lab_hub_wg_ip }}/32, {{ lab_admin_wg_ip }}/32{% if lab_reviewer_enabled | bool %}, {{ lab_reviewer_wg_ip }}/32{% endif %}

Endpoint = {{ lab_hub_lan_ip }}:{{ lab_wireguard_port }}
PersistentKeepalive = {{ lab_wireguard_keepalive }}
{% endif %}
