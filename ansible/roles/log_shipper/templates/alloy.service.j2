{# Native-служба systemd на ubu1: Alloy работает отдельно от Docker и не получает доступ к Docker socket. #}
[Unit]
Description=OZZYLOGIK native Alloy log collector
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
{# Отдельный пользователь и общая группа lab-logs дают чтение журналов без root-прав и без права их менять. #}
User={{ lab_alloy_user }}
Group={{ lab_alloy_group }}
SupplementaryGroups={{ lab_log_group }}
WorkingDirectory={{ lab_alloy_state_dir }}
{# Проверяем конфиг перед каждым стартом; experimental необходим именно для включённого WAL в закреплённой версии. #}
ExecStartPre=/usr/local/bin/alloy validate --config.format=alloy --stability.level=experimental {{ lab_alloy_config_dir }}/config.alloy
{# Постоянный storage.path сохраняет positions/WAL между restart; служебный HTTP открыт только на loopback. #}
ExecStart=/usr/local/bin/alloy run --config.format=alloy --stability.level=experimental --storage.path={{ lab_alloy_state_dir }} --server.http.listen-addr=127.0.0.1:12345 {{ lab_alloy_config_dir }}/config.alloy
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
{# Ограничения systemd оставляют запись лишь в state directory; логи доступны только для чтения. #}
ReadWritePaths={{ lab_alloy_state_dir }}
ReadOnlyPaths={{ lab_web_log_dir }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=384M
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
[Install]
WantedBy=multi-user.target
