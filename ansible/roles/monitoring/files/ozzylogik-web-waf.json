    },
    {
      "id": 6,
      "title": "Запросы / минуту · HTTP-коды",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 8
      },
      "description": "Средняя частота за минуту. Размер окна автоматически подбирается под выбранный период; карточки сверху показывают итоговое количество.",
      "datasource": {
        "type": "loki",
        "uid": "ozzylogik-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "ozzylogik-loki"
          },
          "expr": "sum by (status) (rate({job=\"ozzylogik\",instance=\"ubu1\",log_type=\"access\"} | json status=\"status\", client_ip=\"client_ip\" | __error__=\"\" | client_ip!=\"127.0.0.1\" | client_ip!=\"::1\"[$__interval])) * 60",
          "queryType": "range",
          "instant": false,
          "range": true,
          "editorMode": "code",
          "legendFormat": "HTTP {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 65,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": "запросов / мин",
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP 200"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP 403"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP 404"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP 500"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
