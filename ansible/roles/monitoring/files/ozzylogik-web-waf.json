    {
      "id": 4,
      "title": "Блокировки WAF",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "Прерванные ModSecurity транзакции (transaction.is_interrupted=true). Одна audit-запись считается один раз, независимо от числа сработавших правил.",
      "datasource": {
        "type": "loki",
        "uid": "ozzylogik-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "ozzylogik-loki"
          },
          "expr": "sum(count_over_time({job=\"ozzylogik\",instance=\"ubu1\",log_type=\"audit\"} | json blocked=\"transaction.is_interrupted\", client_ip=\"transaction.client_ip\" | __error__=\"\" | blocked=\"true\" | client_ip!=\"127.0.0.1\" | client_ip!=\"::1\"[$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Уникальные IP",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "Количество разных IP клиентов за выбранный период. Для тестового Windows VPN это 10.77.42.4.",
      "datasource": {
        "type": "loki",
        "uid": "ozzylogik-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "ozzylogik-loki"
          },
          "expr": "count(sum by (client_ip) (count_over_time({job=\"ozzylogik\",instance=\"ubu1\",log_type=\"access\"} | json status=\"status\", client_ip=\"client_ip\" | __error__=\"\" | client_ip!=\"127.0.0.1\" | client_ip!=\"::1\"[$__range]))) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
