{# Loki принимает записи Alloy и запросы Grafana. Его доступ ограничивает guest firewall; собственной HTTP-аутентификации здесь нет. #}
auth_enabled: false
server:
  http_listen_address: 0.0.0.0
  http_listen_port: 3100
  grpc_listen_address: 127.0.0.1
  grpc_listen_port: 9096
  log_level: info
{# Одиночный локальный Loki: нет реплик на других узлах; постоянные данные живут в /var/lib/loki. #}
common:
  instance_addr: 127.0.0.1
  path_prefix: /var/lib/loki
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
{# TSDB/schema v13 задаёт формат индекса, filesystem — локальное хранение, не удалённое object storage. #}
schema_config:
  configs:
    - from: '2024-01-01'
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h
storage_config:
  tsdb_shipper:
    active_index_directory: /var/lib/loki/tsdb-index
    cache_location: /var/lib/loki/tsdb-cache
  filesystem:
    directory: /var/lib/loki/chunks
{# Собственный WAL Loki помогает восстановить приём после restart; это отдельный механизм от WAL сборщика Alloy. #}
ingester:
  wal:
    enabled: true
    dir: /var/lib/loki/wal
{# Compactor обслуживает индексы и удаление по retention; удаление отложено, не происходит мгновенно по границе срока. #}
compactor:
  working_directory: /var/lib/loki/compactor
  compaction_interval: 10m
  retention_enabled: true
  retention_delete_delay: 2h
  retention_delete_worker_count: 2
  delete_request_store: filesystem
limits_config:
{# Ansible подставляет срок хранения из defaults/inventory; настроенный срок ещё не доказывает наблюдённое удаление. #}
  retention_period: {{ lab_loki_retention }}
  ingestion_rate_mb: 2
  ingestion_burst_size_mb: 4
  allow_structured_metadata: true
  volume_enabled: true
{# Ограничения параллельности и cache соответствуют небольшому домашнему стенду. #}
querier:
  max_concurrent: 2
query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 32
analytics:
  reporting_enabled: false
