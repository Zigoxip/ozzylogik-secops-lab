# Guest-only policy. Loaded atomically; never flush the system ruleset.
# Phase {{ lab_phase }}; only a secured phase removes temporary LAN SSH.
table inet ozzylogik {
    set private_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ lab_private_egress_cidrs | join(', ') }} }
    }
    set administrators_v4 {
        type ipv4_addr
        elements = { {{ lab_admin_wg_ip }}{% if lab_reviewer_enabled | bool %}, {{ lab_reviewer_wg_ip }}{% endif %} }
    }
    set vpn_hosts_v4 {
        type ipv4_addr
        elements = { {{ lab_hub_wg_ip }}, {{ lab_web_wg_ip }}, {{ lab_admin_wg_ip }}{% if lab_reviewer_enabled | bool %}, {{ lab_reviewer_wg_ip }}{% endif %} }
    }
    set dns_v4 {
        type ipv4_addr
        elements = { {{ lab_dns_ipv4 | join(', ') }} }
    }
{% if inventory_hostname in groups.get('monitoring', []) %}
    set lan_wg_peers_v4 {
        type ipv4_addr
        elements = { {{ lab_web_lan_ip }}, {{ lab_bootstrap_admin_lan_ip }} }
    }
{% endif %}
{% if inventory_hostname in groups.get('web', []) and lab_demo_http_enabled | bool %}
    set demo_http_v4 {
        type ipv4_addr
        flags interval
        elements = { {{ lab_demo_http_sources | join(', ') }} }
    }
{% endif %}

    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state invalid counter drop

        # Guard service interfaces before generic established acceptance.
        iifname "{{ lab_vpn_interface }}" ip saddr @administrators_v4 tcp dport 22 counter accept
{% if lab_phase == 'bootstrap' %}
        iifname "{{ lab_lan_interface }}" ip saddr {{ lab_bootstrap_admin_lan_ip }} tcp dport 22 counter accept
{% endif %}
{% if inventory_hostname in groups.get('monitoring', []) %}
        iifname "{{ lab_vpn_interface }}" ip saddr @administrators_v4 tcp dport {{ lab_grafana_port }} counter accept
        iifname "{{ lab_vpn_interface }}" ip saddr {{ lab_web_wg_ip }} tcp dport {{ lab_loki_port }} counter accept
{% else %}
        iifname "{{ lab_vpn_interface }}" ip saddr @administrators_v4 tcp dport {{ lab_http_port }} counter accept
{% if lab_demo_http_enabled | bool %}
        iifname "{{ lab_lan_interface }}" ip saddr @demo_http_v4 tcp dport {{ lab_http_port }} counter accept
{% endif %}
{% endif %}
        tcp dport { 22, {{ lab_http_port }}, {{ lab_grafana_port }}, {{ lab_loki_port }} } counter drop

        # IPv6 applications are denied; preserve only local neighbor discovery.
        iifname "{{ lab_lan_interface }}" ip6 saddr { ::/128, fe80::/10 } ip6 hoplimit 255 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept
{% if lab_dhcpv6_enabled | bool %}
        iifname "{{ lab_lan_interface }}" ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
{% endif %}
        meta nfproto ipv6 counter drop
        ct state established,related accept
        iifname "{{ lab_lan_interface }}" ip saddr {{ lab_dhcp_server_ipv4 }} udp sport 67 udp dport 68 accept
{% if inventory_hostname in groups.get('monitoring', []) %}
        # WAN DNAT, if separately enabled for the demo, also arrives on this NIC.
        iifname "{{ lab_lan_interface }}" meta nfproto ipv4 udp dport {{ lab_wireguard_port }} counter accept
{% else %}
        iifname "{{ lab_lan_interface }}" ip saddr {{ lab_hub_lan_ip }} udp sport {{ lab_wireguard_port }} udp dport {{ lab_wireguard_port }} counter accept
{% endif %}
        iifname "{{ lab_vpn_interface }}" ip saddr @administrators_v4 icmp type echo-request accept
        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state invalid counter drop
{% if inventory_hostname in groups.get('monitoring', []) %}
        iifname "{{ lab_vpn_interface }}" oifname "{{ lab_vpn_interface }}" ip saddr @administrators_v4 ip daddr {{ lab_web_wg_ip }} ct state established,related accept
        iifname "{{ lab_vpn_interface }}" oifname "{{ lab_vpn_interface }}" ip saddr {{ lab_web_wg_ip }} ip daddr @administrators_v4 ct state established,related accept
        iifname "{{ lab_vpn_interface }}" oifname "{{ lab_vpn_interface }}" ip saddr @administrators_v4 ip daddr {{ lab_web_wg_ip }} tcp dport { 22, {{ lab_http_port }} } ct state new counter accept
{% endif %}
        # No LAN forwarding, default route, or tunnel NAT.
        counter drop
    }

    chain output {
        type filter hook output priority filter; policy drop;
        oifname "lo" accept
        ct state invalid counter drop
        oifname "{{ lab_lan_interface }}" udp sport 68 udp dport 67 ip daddr { 255.255.255.255, {{ lab_dhcp_server_ipv4 }} } accept
        oifname "{{ lab_lan_interface }}" ip daddr @dns_v4 udp dport 53 accept
        oifname "{{ lab_lan_interface }}" ip daddr @dns_v4 tcp dport 53 accept

{% if lab_phase == 'bootstrap' %}
        # First activation may see a reply on an SSH flow predating conntrack.
        oifname "{{ lab_lan_interface }}" ip daddr {{ lab_bootstrap_admin_lan_ip }} tcp sport 22 accept
{% endif %}
{% if inventory_hostname in groups.get('monitoring', []) %}
        oifname "{{ lab_lan_interface }}" ip daddr @lan_wg_peers_v4 udp sport {{ lab_wireguard_port }} accept
        oifname "{{ lab_lan_interface }}" ip daddr @lan_wg_peers_v4 ip protocol icmp ct state related accept
{% else %}
        oifname "{{ lab_lan_interface }}" ip daddr {{ lab_hub_lan_ip }} udp sport {{ lab_wireguard_port }} udp dport {{ lab_wireguard_port }} accept
        oifname "{{ lab_vpn_interface }}" ip daddr {{ lab_hub_wg_ip }} tcp dport {{ lab_loki_port }} accept
{% if lab_demo_http_enabled | bool %}
        oifname "{{ lab_lan_interface }}" ip daddr @demo_http_v4 tcp sport {{ lab_http_port }} ct state established accept
{% endif %}
{% endif %}
        oifname "{{ lab_vpn_interface }}" ip daddr @vpn_hosts_v4 ct state established,related accept
        oifname "{{ lab_vpn_interface }}" ip daddr @vpn_hosts_v4 icmp type { destination-unreachable, time-exceeded, parameter-problem } ct state related accept

        oifname "{{ lab_lan_interface }}" ip6 saddr { ::/128, fe80::/10 } ip6 daddr { fe80::/10, ff02::/16 } ip6 hoplimit 255 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept
{% if lab_dhcpv6_enabled | bool %}
        oifname "{{ lab_lan_interface }}" ip6 saddr fe80::/10 ip6 daddr { fe80::/10, ff02::1:2 } udp sport 546 udp dport 547 accept
{% endif %}
        meta nfproto ipv6 counter drop
        # Private destinations are rejected before generic established traffic.
        ip daddr @private_v4 counter drop
        meta nfproto ipv4 ct state established,related accept
{% if inventory_hostname in groups.get('monitoring', []) %}
        # Learned public WG endpoints may have translated/random client ports.
        oifname "{{ lab_lan_interface }}" meta nfproto ipv4 udp sport {{ lab_wireguard_port }} accept
{% endif %}
        oifname "{{ lab_lan_interface }}" meta nfproto ipv4 udp dport 123 accept
        oifname "{{ lab_lan_interface }}" meta nfproto ipv4 tcp dport { 80, 443 } accept
        counter drop
    }
}
