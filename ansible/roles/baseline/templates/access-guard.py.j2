#!/usr/bin/python3
"""Guest-only access transaction. Snapshots contain secrets: root 0700/0600."""
import datetime
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

os.umask(0o077)
{# Jinja-комментарии не попадут в Python-файл: учебные пояснения не меняют его checksum. #}
ROOT = Path('/var/lib/ozzylogik/access-rollback')
PENDING = ROOT / 'pending'
TIMER = 'ozzylogik-access-rollback.timer'
WG = 'wg-quick@{{ lab_vpn_interface }}.service'
FW = 'ozzylogik-firewall.service'
{# Страховка сохраняет только этот список access-файлов, не весь диск или состояние VM. #}
FILES = [
    '/etc/ssh/sshd_config.d/00-ozzylogik.conf',
    '/etc/wireguard/{{ lab_vpn_interface }}.conf',
    '/etc/sysctl.d/90-ozzylogik-wireguard.conf',
    '/etc/nftables.d/ozzylogik.nft',
    '/etc/systemd/system/ozzylogik-firewall.service',
    '/usr/local/sbin/ozzylogik-nft-load',
]
SYSCTLS = ['net.ipv4.ip_forward', 'net.ipv6.conf.all.forwarding']


def run(args, check=True, data=None):
    result = subprocess.run(args, input=data, text=True, capture_output=True)
    if check and result.returncode:
        # Never include file contents, keys, or arbitrary tool output in errors.
        raise RuntimeError('Command failed: ' + ' '.join(args[:2]))
    return result


def service_state(name):
    return {
        'active': run(['systemctl', 'is-active', '--quiet', name], False).returncode == 0,
        'enabled': run(['systemctl', 'is-enabled', '--quiet', name], False).returncode == 0,
    }


def erase_pending():
    if PENDING.is_symlink() or PENDING.resolve() != ROOT.resolve() / 'pending':
        raise RuntimeError('Unsafe snapshot path')
    if PENDING.exists():
        shutil.rmtree(PENDING)


{# Первый arm создаёт снимок; при pending проверяет таймер и сохраняет прежний срок. #}
def arm():
    if PENDING.exists():
        substate = run(['systemctl', 'show', TIMER, '-p', 'SubState', '--value']).stdout.strip()
        if substate != 'waiting':
            raise RuntimeError('Pending snapshot has no waiting timer; use console recovery')
        print('pending')
        return
    staging = Path(tempfile.mkdtemp(prefix='new-', dir=ROOT))
    try:
{# Запоминаем файлы, свою nft-таблицу, forwarding и active/enabled двух служб. #}
        state = {
            'armed_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
            'files': {}, 'services': {name: service_state(name) for name in [WG, FW]},
            'sysctls': {name: run(['sysctl', '-n', name]).stdout.strip() for name in SYSCTLS},
        }
        for index, filename in enumerate(FILES):
            source = Path(filename)
            if source.is_symlink():
                raise RuntimeError('Managed access file must not be a symlink')
            exists = source.is_file()
            state['files'][filename] = {'exists': exists, 'backup': str(index)}
            if exists:
                metadata = source.stat()
                state['files'][filename].update(mode=metadata.st_mode & 0o7777, uid=metadata.st_uid, gid=metadata.st_gid)
                shutil.copy2(source, staging / str(index))
                os.chmod(staging / str(index), 0o600)
        old_table = run(['nft', 'list', 'table', 'inet', 'ozzylogik'], False)
        state['table_exists'] = old_table.returncode == 0
        if state['table_exists']:
            (staging / 'table.nft').write_text(old_table.stdout)
        (staging / 'state.json').write_text(json.dumps(state))
{# Готовый снимок становится pending до запуска таймера, чтобы откат видел полное состояние. #}
        staging.rename(PENDING)
        run(['systemctl', 'reset-failed', 'ozzylogik-access-rollback.service'], False)
        run(['systemctl', 'enable', TIMER])
        run(['systemctl', 'restart', TIMER])
        if run(['systemctl', 'show', TIMER, '-p', 'SubState', '--value']).stdout.strip() != 'waiting':
            raise RuntimeError('Rollback timer is not waiting')
        print('armed')
    finally:
        if staging.exists():
            shutil.rmtree(staging)


def restore_service(name, saved):
    run(['systemctl', 'enable' if saved['enabled'] else 'disable', name], False)
    if saved['active']:
        run(['systemctl', 'start', name])


{# Возвращаем сохранённое состояние; пользователей, пакеты и внешнюю сеть не откатываем. #}
def rollback():
    if not PENDING.exists():
        print('unchanged')
        return
    state = json.loads((PENDING / 'state.json').read_text())
    for name in [WG, FW]:
        run(['systemctl', 'stop', name], False)
    for filename in FILES:
        saved = state['files'][filename]
        path = Path(filename)
        if saved['exists']:
            path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(PENDING / saved['backup'], path)
            os.chmod(path, saved['mode'])
            os.chown(path, saved['uid'], saved['gid'])
        elif path.exists() or path.is_symlink():
            path.unlink()
    batch = ''
    if run(['nft', 'list', 'table', 'inet', 'ozzylogik'], False).returncode == 0:
        batch += 'delete table inet ozzylogik\n'
    if state['table_exists']:
        batch += (PENDING / 'table.nft').read_text()
    if batch:
        run(['nft', '-c', '-f', '-'], data=batch)
        run(['nft', '-f', '-'], data=batch)
    for name, value in state['sysctls'].items():
        run(['sysctl', '-w', name + '=' + value])
    run(['systemctl', 'daemon-reload'])
    for name in [FW, WG]:
        restore_service(name, state['services'][name])
{# SSH активируем лишь после проверки; при ошибке snapshot остаётся для recovery. #}
    run(['/usr/sbin/sshd', '-t'])
    run(['systemctl', 'reload-or-restart', 'ssh.service'])
    run(['systemctl', 'disable', '--now', TIMER])
    erase_pending()
    print('rolled-back')


{# Commit снимает страховку, но сам не проверяет доступность и не ужесточает SSH/firewall. #}
def commit():
    if not PENDING.exists():
        print('unchanged')
        return
    run(['systemctl', 'disable', '--now', TIMER])
    erase_pending()
    print('committed')


def main():
    if os.geteuid() != 0 or len(sys.argv) != 2 or sys.argv[1] not in ['arm', 'commit', 'rollback', 'status']:
        raise RuntimeError('Use as root: ozzylogik-access-guard arm|commit|rollback|status')
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (ROOT / 'lock').open('a') as lock:
{# Lock не даёт двум вызовам helper одновременно менять один pending-снимок. #}
        fcntl.flock(lock, fcntl.LOCK_EX)
        if sys.argv[1] == 'status':
            print('pending' if PENDING.exists() else 'clear')
        else:
            {'arm': arm, 'rollback': rollback, 'commit': commit}[sys.argv[1]]()


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
